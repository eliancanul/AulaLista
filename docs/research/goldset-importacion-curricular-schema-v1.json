{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aulalista.local/schemas/curriculum-pdf-goldset-1.0.0.json",
  "title": "AulaLista curriculum PDF gold-set annotation",
  "type": "object",
  "required": ["schema_version", "annotation_id", "annotator", "document_sha256", "page", "page_state", "regions", "review_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "annotation_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "annotator": {"type": "string", "minLength": 1},
    "document_id": {"type": "string"},
    "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "page": {"type": "integer", "minimum": 1},
    "page_state": {"enum": ["included", "reference_only", "quarantined", "excluded"]},
    "page_reason": {"type": "string", "minLength": 1},
    "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "review_status": {"enum": ["independent", "adjudicated"]}
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height", "coordinate_system"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "coordinate_system": {"const": "normalized_top_left_xywh"}
      }
    },
    "evidence_span": {
      "type": "object",
      "required": ["page", "bbox", "text", "method"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "text": {"type": "string"},
        "method": {"enum": ["native", "ocr", "derived", "visual"]}
      }
    },
    "region": {
      "type": "object",
      "required": ["region_id", "class", "bbox", "reading_order", "state", "evidence"],
      "properties": {
        "region_id": {"type": "string"},
        "class": {"enum": ["title", "paragraph", "list", "table", "figure", "form", "header", "footer", "plan", "session", "phase", "activity", "resource", "assessment", "worksheet", "rubric", "cover", "promotional", "unknown"]},
        "bbox": {"$ref": "#/$defs/bbox"},
        "reading_order": {"type": "integer", "minimum": 1},
        "state": {"enum": ["included", "reference_only", "quarantined", "excluded"]},
        "reason": {"type": "string"},
        "text": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_span"}},
        "table": {"type": ["object", "null"]},
        "hierarchy_path": {"type": "array", "items": {"type": "string"}}
      }
    },
    "relation": {
      "type": "object",
      "required": ["kind", "from_region_id", "to_region_id", "state"],
      "properties": {
        "kind": {"enum": ["contains", "continues_on", "session_uses_resource", "session_uses_annex", "contradicts", "unknown"]},
        "from_region_id": {"type": "string"},
        "to_region_id": {"type": "string"},
        "state": {"enum": ["included", "reference_only", "quarantined", "excluded"]}
      }
    }
  }
}
